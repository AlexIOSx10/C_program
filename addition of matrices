#include<stdio.h>
int main(){

int a[5][5],b[5][5];
int row, col, i, j;

 printf("Enter numbers of rows and coloumbs\n");
 scanf("%d %d",&row,&col);

   printf("Enter elements of first matrix\n");
    for(i=0;i<row;i++) {
        for(j=0;j<col;j++) {
            scanf("%d",&a[i][j]);
        }
    }

    printf("Enter elements of second matrix\n");
    for(i=0;i<row;i++) {
        for(j=0;j<col;j++) {
            scanf("%d",&b[i][j]);
        }
    }
int sum[5][5];

   for(i=0;i<row;i++){
        for(j=0;j<col;j++){
           sum[i][j] = a[i][j] + b[i][j];
        }
    }
    printf("Printing Sum of two matrix\n");
    for(i=0;i<row;i++){
        for(j=0;j<col;j++){
           printf("%d\n",sum[i][j]);
        }
    }

return 0;
}
