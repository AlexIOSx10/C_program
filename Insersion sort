#include <stdio.h>

int main() {
  int arr[5]={59,71,58,50,102,56};
  int i = 1;
  int j;
  int temp;

  while(i<5){
   temp = arr[i];
    j = i - 1;
  while(j >= 0 && arr[j]>temp){
    arr[j+1] = arr[j];
    j--;
  }
  arr[j+1]=temp;
  i++;
  }
  for(i=0;i<5;i++){
    printf("%d\n",arr[i]);
  }
    return 0;
}
