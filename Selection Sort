#include <stdio.h>

int main() {
  int arr[6]={59,71,58,50,102,56};
  int i;
  int j;
  int temp, min;

for(i=0;i<5;i++){
    min = i;
    for(j=i+1;j<6;j++){
        if(arr[j]<arr[min]){
            min = j;
        }
    }
    temp = arr[i];
    arr[i] = arr[min];
    arr[min] = temp;
}
  for (i = 0; i < 6; i++) {
        printf("%d\n", arr[i]);
    }


    return 0;
}
