#include <stdio.h>

int main() {
    int a[5] = {1, 5, 4, 2, 3};
    int i, j = 0;
    int temp, min_index;

while (j < 4) {
    min_index = j;

for (i = j + 1; i < 5; i++) {
    if (a[i] < a[min_index]) {
                min_index = i;
            }
        }

        temp = a[min_index];
        a[min_index] = a[j];
        a[j] = temp;

        j++;
    }

for (i = 0; i < 5; i++) {
        printf("%d\n", a[i]);
    }

    return 0;
}
